#!/usr/bin/env bash
set -euo pipefail

DEFAULT_REGION="us-east-1"

usage() {
  echo "Usage: secret2env [secret-name] [region]"
  echo "Downloads an AWS Secrets Manager secret into ./.env.<timestamp>"
  echo "Prompts for the secret name if not given. Region defaults to ${DEFAULT_REGION}."
}

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: '$1' is not installed or not on PATH." >&2
    exit 1
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

require aws
require jq

secret_name="${1:-}"
region="${2:-$DEFAULT_REGION}"

if [[ -z "$secret_name" ]]; then
  read -r -p "AWS Secrets Manager secret name: " secret_name
fi

if [[ -z "$secret_name" ]]; then
  echo "Error: secret name is required." >&2
  exit 1
fi

# Fetch and convert before writing so a failure never leaves an empty or partial .env file.
secret_string="$(aws secretsmanager get-secret-value \
  --secret-id "$secret_name" \
  --region "$region" \
  --query SecretString \
  --output text)"

if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$secret_string"; then
  echo "Error: secret '$secret_name' is not a JSON key/value object." >&2
  exit 1
fi

env_content="$(jq -r 'to_entries | map("\(.key)=\"\(.value | tostring)\"") | .[]' <<<"$secret_string")"

output_file=".env.$(date +%Y%m%d-%H%M%S)"

# The file contains secrets, so restrict it to the current user.
umask 077
printf '%s\n' "$env_content" >"$output_file"

echo "Saved $(wc -l <"$output_file" | tr -d ' ') variables to $(pwd)/$output_file"
